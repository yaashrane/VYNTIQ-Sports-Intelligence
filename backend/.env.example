# ==============================================================================
# VYNTIQ — Backend Environment Configuration Example
# Copy this file to '.env' and adjust parameters for your environment.
# Never commit active secrets or credentials to version control.
# ==============================================================================

# Core Metadata
PROJECT_NAME="VYNTIQ API"
SERVICE_NAME="vyntiq-api"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment: development | staging | production | testing
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Security & Cryptography
# Generate a secure 32+ character key for production: openssl rand -hex 32
SECRET_KEY="vyntiq-insecure-dev-secret-key-change-in-production-min32chars"

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration (ADR-005)
# Local Development (SQLite):
DATABASE_URL="sqlite+aiosqlite:///./vyntiq_dev.db"

# Production Target (PostgreSQL 16):
# DATABASE_URL="postgresql+asyncpg://vyntiq_user:secure_password@localhost:5432/vyntiq_db"

DB_ECHO=false

# File Storage Configuration (ADR-004)
UPLOAD_DIR="storage/uploads/raw"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

